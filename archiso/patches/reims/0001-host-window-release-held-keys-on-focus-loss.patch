+
+/// LayerOSX: evdev codes currently pressed in the host window, so a focus loss
+/// can release them in the guest (see `WindowEvent::Focused(false)`).
+static HELD_KEYS: Mutex<Vec<u32>> = Mutex::new(Vec::new());
+
+fn held_keys_track(evdev: u32, down: bool) {
+    let mut held = HELD_KEYS.lock().unwrap_or_else(|p| p.into_inner());
+    held.retain(|&k| k != evdev);
+    if down {
+        held.push(evdev);
+    }
+}
+
+fn held_keys_drain() -> Vec<u32> {
+    std::mem::take(&mut *HELD_KEYS.lock().unwrap_or_else(|p| p.into_inner()))
+}
