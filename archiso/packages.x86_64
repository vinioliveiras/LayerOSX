# Base system (all of this stays on the ISO and is copied as-is by
# install-wizard.sh's rsync step — none of this gets installed during
# the live session itself).
base
base-devel
linux
linux-firmware
linux-headers
mkinitcpio
# Provides the archiso/archiso_loop_mnt/memdisk/... mkinitcpio hooks
# (and the memdiskfind binary they need) referenced by
# airootfs/etc/mkinitcpio.conf.d/archiso.conf. Without this package,
# mkarchiso still builds an ISO, but its initramfs can't find its own
# live root: it boots into a black screen, then an endless
# `systemd-gpt-auto-generator` / emergency-mode loop (root is locked,
# so you can't even log in to debug it). Confirmed against the
# official releng reference profile's packages.x86_64.
mkinitcpio-archiso
# Required by the bios.syslinux bootmode in profiledef.sh (mkarchiso
# extracts the actual syslinux binaries from this package to embed in
# the ISO's isohybrid MBR/El Torito boot catalog -- see README.md for
# why that mode is enabled at all on a UEFI-only project). Without it,
# mkarchiso refuses to build: "ERROR: Validating 'bios.syslinux': The
# 'syslinux' package is missing from the package list!"
syslinux
# Not required, just quiets mkarchiso's informational notices about
# memory testing being unavailable from the syslinux/systemd-boot
# menus -- harmless either way, but keeps real errors from getting
# lost in the noise on the next build.
memtest86+
memtest86+-efi
sudo
git
nano
networkmanager
efibootmgr
grub
os-prober
dosfstools
btrfs-progs
e2fsprogs
ntfs-3g
rsync
arch-install-scripts

# CPU microcode — both included unconditionally (tiny, harmless): the
# bootloader only loads the one that actually matches the CPU present.
intel-ucode
amd-ucode

# GPU drivers for all three vendors — baked in unconditionally.
# postinstall/10-hardware-detect.sh detects what's REALLY plugged into
# the machine being installed and only *enables* the relevant modules
# and services; the packages themselves don't need matching hardware
# present at install time (mesa is vendor-neutral, nvidia-open-dkms
# just compiles its kernel module against the kernel headers already
# on the ISO). Reims-vGPU accelerates over Vulkan on the host, so any
# of these three is a valid target, not just NVIDIA.
nvidia-open-dkms
nvidia-utils
nvidia-settings
mesa
vulkan-radeon
vulkan-intel

# Generic X11 framebuffer driver — fallback for GPUs/virtual adapters
# that don't get a working DRM/KMS "modesetting" driver on their own
# (common in VMs without full 3D passthrough). Xorg still prefers a
# proper driver (nvidia/modesetting) when one works; this only kicks
# in when nothing else does, instead of Xorg crash-looping (which
# looks like the screen endlessly flickering, because tty1 autologin
# + .bash_profile retries `startx` every time X dies).
xf86-video-fbdev

# KVM / QEMU / VM firmware
qemu-base
qemu-img
edk2-ovmf
swtpm
python
python-yaml
curl

# Vulkan (Reims-vGPU backend)
vulkan-icd-loader
vulkan-tools
vulkan-headers

# build tools for qemus/qemu-macos and dmg2img (compiled at build time
# by customize_airootfs.sh — none of this stays exposed on the final
# system besides the already-built binaries)
meson
ninja
pkgconf
cmake
glib2
pixman
sdl2

# automatic cleanup (paccache)
pacman-contrib

# graphical first-run wizard (choosing the macOS source)
zenity

# live environment: just enough to run GParted + zenity graphically
# (Calamares would need Chaotic-AUR or an AUR source build — see
# README.md — GParted is official and does exactly the one job we
# actually need, partitioning)
xorg-server
xorg-xinit
xorg-xsetroot
openbox
gparted
