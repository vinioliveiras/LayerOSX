# Base system (all of this stays on the ISO and is copied as-is by
# Calamares — none of this gets installed during Calamares itself,
# unpackfs just copies the live rootfs).
base
base-devel
linux
linux-firmware
linux-headers
mkinitcpio
sudo
git
nano
networkmanager
efibootmgr
grub
os-prober
dosfstools
btrfs-progs
e2fsprogs
ntfs-3g

# NVIDIA (same package already validated on CachyOS)
nvidia-open-dkms
nvidia-utils
nvidia-settings

# KVM / QEMU / VM firmware
qemu-base
qemu-img
edk2-ovmf
swtpm
python
python-yaml
curl

# Vulkan (Reims-vGPU backend)
vulkan-icd-loader
vulkan-tools
vulkan-headers

# build tools for qemus/qemu-macos and dmg2img (compiled at build time
# by customize_airootfs.sh — none of this stays exposed on the final
# system besides the already-built binaries)
meson
ninja
pkgconf
cmake
glib2
pixman
sdl2

# automatic cleanup (paccache)
pacman-contrib

# graphical first-run wizard (choosing the macOS source)
zenity

# live environment: just enough to run Calamares graphically
xorg-server
xorg-xinit
openbox
calamares
qt6-svg
kpmcore
