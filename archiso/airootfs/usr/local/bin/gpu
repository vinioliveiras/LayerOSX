#!/usr/bin/env bash
# Switch the macOS VM's graphics adapter without a rebuild and without
# reinstalling macOS -- the disk stays the same, only which GPU QEMU
# hands the guest changes on the next launch (macOS redetects it and
# loads the right driver; Reims uses the stock AppleParavirtGPU.kext).
#
#   gpu            show the current setting
#   gpu reims      Reims vGPU (hardware-accelerated, alpha) next launch
#   gpu vmware     VMware SVGA (reliable, unaccelerated -- the default)
#   gpu std        stock std VGA (OVMF gives a linear framebuffer -- "no linesize" A/B)
#
# After switching, relaunch the VM: run `relaunch` (or reboot).
set -uo pipefail
GFX_FILE="/var/lib/layerosx/gfx"

# shellcheck source=/dev/null
source /opt/layerosx/kiosk/lib/settings.sh
current() {
    case "$(effective_setting gfx)" in
        reims) echo "reims (hardware-accelerated, alpha) [$(setting_origin gfx)]" ;;
        std)   echo "std (stock VGA, OVMF linear framebuffer) [$(setting_origin gfx)]" ;;
        *)     echo "vmware (reliable, unaccelerated) [$(setting_origin gfx)]" ;;
    esac
}

case "${1:-}" in
    "")
        echo "macOS VM graphics adapter: $(current)"
        echo "Change it with:  gpu reims   |   gpu vmware   |   gpu std"
        echo "Then run:        relaunch          (or reboot)"
        ;;
    reims|reims-vgpu-pci)
        sudo mkdir -p "$(dirname "$GFX_FILE")"
        echo reims | sudo tee "$GFX_FILE" >/dev/null
        echo "Graphics set to Reims vGPU (hardware-accelerated, alpha)."
        echo "Relaunch to apply:  relaunch       (or reboot)"
        echo "If the VM won't boot on Reims, come back with:  gpu vmware"
        ;;
    vmware|vmware-svga)
        sudo mkdir -p "$(dirname "$GFX_FILE")"
        echo vmware | sudo tee "$GFX_FILE" >/dev/null
        echo "Graphics set to VMware SVGA (reliable, unaccelerated)."
        echo "Relaunch to apply:  relaunch       (or reboot)"
        ;;
    std|std-vga|vga)
        sudo mkdir -p "$(dirname "$GFX_FILE")"
        echo std | sudo tee "$GFX_FILE" >/dev/null
        echo "Graphics set to stock std VGA -- OVMF publishes a linear framebuffer GOP."
        echo "This is the A/B test for the 'no linesize' stall: if macOS draws on std"
        echo "but not on vmware/reims, the framebuffer the vGPU hands XNU is the culprit."
        echo "Relaunch to apply:  relaunch       (or reboot)"
        ;;
    *)
        echo "usage: gpu [reims|vmware|std]   (no argument = show current setting)" >&2
        exit 2
        ;;
esac
