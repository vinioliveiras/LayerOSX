#!/usr/bin/env bash
# Toggle a USB audio device for the macOS VM without a rebuild -- it only
# changes whether the launcher attaches `-device usb-audio` on the next launch
# (macOS drives it with its built-in AppleUSBAudio driver, no kext needed).
#
#   audio            show the current setting
#   audio on         attach a usb-audio device next launch (sound, if supported)
#   audio off        no audio device (sound is on by default)
#
# Default is OFF, on purpose: sound is not required to install or run macOS,
# and this way the audio path can never interfere with a boot that's still
# being brought up. When ON, the launcher first checks that this build's QEMU
# actually has a usb-audio device and an audio backend compiled in; if it
# doesn't, it prints a warning and boots WITHOUT audio rather than failing --
# so turning this on is always safe to try.
#
# NOTE: whether sound actually comes out also depends on (a) the custom
# qemu-macos binary having been built with an audio backend (it's built for
# VNC/noVNC, so it may not be -- see DEVLOG.md), and (b) the host's
# sound card working under Linux. If `audio on` boots but there's no sound,
# that's the QEMU-build side, which needs the build patched and QEMU rebuilt.
#
# After switching, relaunch the VM: run `relaunch` (or reboot).
set -uo pipefail
AUDIO_FILE="/var/lib/layerosx/audio"

# shellcheck source=/dev/null
source /opt/layerosx/kiosk/lib/settings.sh
current() {
    case "$(effective_setting audio)" in
        on) echo "on (usb-audio attached, if this build supports it) [$(setting_origin audio)]" ;;
        *)  echo "off (no audio device) [$(setting_origin audio)]" ;;
    esac
}

case "${1:-}" in
    "")
        echo "macOS VM audio: $(current)"
        echo "Change it with:  audio on   |   audio off"
        echo "Then run:        relaunch          (or reboot)"
        ;;
    on|1|yes|true)
        sudo mkdir -p "$(dirname "$AUDIO_FILE")"
        echo on | sudo tee "$AUDIO_FILE" >/dev/null
        echo "Audio ON -- a usb-audio device will be attached next launch (if this QEMU build supports it)."
        echo "Relaunch to apply:  relaunch       (or reboot)"
        echo "No sound after a relaunch? Check Settings > Sound > Output, then 'macdiag' (SOUND section)."
        ;;
    off|0|no|false)
        sudo mkdir -p "$(dirname "$AUDIO_FILE")"
        echo off | sudo tee "$AUDIO_FILE" >/dev/null
        echo "Audio OFF -- no audio device next launch."
        echo "Relaunch to apply:  relaunch       (or reboot)"
        ;;
    *)
        echo "usage: audio [on|off]   (no argument = show current setting)" >&2
        exit 2
        ;;
esac
